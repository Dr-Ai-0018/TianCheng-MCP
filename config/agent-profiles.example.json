{
  "version": 3,
  "inherit_defaults": true,
  "profiles": [
    {
      "name": "pi-local-example",
      "provider": "pi",
      "pi": { "provider": "example-provider", "model": "example-model" },
      "auth": { "mode": "env", "credential_env": "EXAMPLE_PI_KEY" }
    },
    {
      "name": "codex-custom",
      "provider": "codex",
      "provider_profile": "custom",
      "auth": {
        "mode": "existing-login"
      }
    },
    {
      "name": "claude-trusted",
      "provider": "claude-code",
      "provider_profile": "local-default",
      "claude_command_mode": "trusted-shell",
      "auth": {
        "mode": "existing-login"
      }
    },
    {
      "name": "codex-isolated",
      "provider": "codex",
      "provider_profile": "isolated",
      "codex_home": "<ABSOLUTE_CODEX_HOME>",
      "windows_home_preflight": "require-existing",
      "auth": {
        "mode": "env",
        "credential_env": "EXAMPLE_AGENT_KEY"
      }
    }
  ]
}
