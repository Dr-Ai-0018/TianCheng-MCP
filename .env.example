# Optional plaintext fallback used only by tc.ps1.
# Prefer the Windows user environment option in the TUI when practical.
CONTROL_PLANE_API_KEY=

# Outbound proxy: set HTTP_PROXY, HTTPS_PROXY and NO_PROXY in the process
# environment, or use config/launcher.local.json's proxy section.
# HTTP_PROXY/HTTPS_PROXY values can be http://, https://, socks5:// or socks5h:// URLs.
# This .env file is only a credential fallback; it does not load proxy values.
# Agent proxy mode belongs in config/launcher.local.json: off, selective, always.
